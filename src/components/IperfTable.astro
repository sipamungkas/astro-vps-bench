---
/**
 * Tabel hasil iperf3.
 *
 * Kecepatan disimpan sebagai string ("412.55 Mbit/s") karena satuan berbeda
 * antar lokasi pengukuran. Nilai 0.00 sudah diubah "busy" oleh parser,
 * mengikuti perilaku YABS aslinya.
 */
import type { IperfResult } from '../types/bench';

interface Props {
  results: IperfResult[];
  ipVersion?: 'IPv4' | 'IPv6';
}

const { results, ipVersion = 'IPv4' } = Astro.props;
const show = (v: string | null | undefined) => v ?? '—';
---

<div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl shadow-lg p-6">
  <h3 class="text-lg font-bold mb-4 text-cyan-400">
    Network Speed Tests (iperf3 {ipVersion})
  </h3>
  <div class="overflow-x-auto">
    <table class="w-full text-left table-auto text-sm">
      <thead>
        <tr class="bg-gray-800 text-gray-300">
          <th class="p-3 font-semibold">Provider</th>
          <th class="p-3 font-semibold">Location</th>
          <th class="p-3 font-semibold">Send Speed</th>
          <th class="p-3 font-semibold">Recv Speed</th>
          <th class="p-3 font-semibold">Ping</th>
        </tr>
      </thead>
      <tbody>
        {results.map((r) => (
          <tr class="border-b border-gray-800 hover:bg-cyan-900/20 transition">
            <td class="p-3 font-mono text-cyan-200">{show(r.provider)}</td>
            <td class="p-3">{show(r.loc)}</td>
            <td class="p-3">{show(r.send)}</td>
            <td class="p-3">{show(r.recv)}</td>
            <td class="p-3">{show(r.latency)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>