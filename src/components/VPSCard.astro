---
import type { CollectionEntry } from 'astro:content';

interface Props {
  vps: CollectionEntry<'vps'>;
}

const { vps } = Astro.props;
const { data, slug } = vps;
---

<a href={`/vps/${slug}`} class="block rounded-2xl bg-white/5 backdrop-blur-md border border-white/10 shadow-lg hover:shadow-xl hover:scale-[1.025] hover:brightness-110 transition-all duration-200 p-6 group">
  <div class="flex items-center justify-between mb-2">
    <span class="text-lg font-semibold text-cyan-400 group-hover:text-blue-400 transition">{data.provider}</span>
    <span class="text-xs bg-cyan-900/40 text-cyan-200 px-2 py-0.5 rounded-full uppercase tracking-wide">{data.status}</span>
  </div>
  <h2 class="text-2xl font-bold mb-1 text-white group-hover:text-cyan-300 transition">{data.title}</h2>
  <div class="text-gray-300 text-sm mb-4">{data.location}</div>
  <div class="flex items-center gap-4 mb-4">
    <span class="text-xl font-extrabold text-green-400">{new Intl.NumberFormat('en-US', { style: 'currency', currency: data.currency }).format(data.price_monthly)}</span>
    <span class="text-xs text-gray-400">/month</span>
  </div>
  <div class="flex flex-wrap gap-2 text-xs text-gray-400 mb-2">
    <span>{data.cpu_cores} CPU</span>
    <span>{data.ram_gb} GB RAM</span>
    <span>{data.storage_gb} GB {data.storage_type}</span>
    <span>{data.bandwidth_tb} TB BW</span>
  </div>
  <div class="flex flex-wrap gap-1 mt-2">
    {data.tags.map(tag => (
      <span class="bg-cyan-800/30 text-cyan-200 px-2 py-0.5 rounded-full text-[11px] font-mono tracking-wide">{tag}</span>
    ))}
  </div>
</a> 