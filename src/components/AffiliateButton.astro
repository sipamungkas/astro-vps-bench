---
interface Props {
  link: string;
  providerName?: string;
}

const { link, providerName = 'this provider' } = Astro.props;
---

<a
  href={link}
  target="_blank"
  rel="noopener noreferrer sponsored"
  class="inline-flex h-[42px] items-center gap-2.5 bg-accent px-[18px] text-[13px] font-semibold text-white transition-opacity hover:opacity-90"
>
  Buy from {providerName}
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 17L17 7M9 7h8v8" />
  </svg>
</a>