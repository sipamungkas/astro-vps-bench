---
import "../styles/global.css";

export interface Props {
	title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro VPS Benchmarks - Modern Minimalist UI" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-gradient-to-br from-gray-950 via-gray-900 to-gray-800 text-white font-sans antialiased">
		<header class="sticky top-0 z-30 w-full bg-gray-900/70 backdrop-blur border-b border-gray-800 shadow-sm">
			<div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
				<a href="/" class="text-2xl font-extrabold tracking-tight bg-gradient-to-r from-cyan-400 to-blue-500 text-transparent bg-clip-text">VPS Bench</a>
				<span class="text-xs text-gray-400 font-mono tracking-widest uppercase">Modern Minimalist</span>
			</div>
		</header>
		<main class="max-w-5xl mx-auto px-4 py-8">
			<slot />
		</main>
		<footer class="text-center text-xs text-gray-500 py-8 opacity-70">
			&copy; {new Date().getFullYear()} VPS Bench. Built with Astro.
		</footer>
	</body>
</html>
