---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

/**
 * The plan payload.
 *
 * This page is rendered in the browser from `?ids=`, so every VPS in the
 * collection is embedded here. Only fields the matrix actually reads are
 * included: the `benchmarks` block would otherwise add hundreds of KB per
 * plan to the HTML. Raw YABS/bench.sh text is not in the JSON at all.
 */
const slim = (await getCollection('vps')).map((v) => ({
  slug: v.data.slug,
  provider: v.data.provider,
  title: v.data.title,
  location: v.data.location ?? '',
  price_monthly: v.data.price_monthly ?? null,
  currency: v.data.currency ?? 'USD',
  cpu_cores: v.data.cpu_cores ?? null,
  ram_gb: v.data.ram_gb ?? null,
  storage_gb: v.data.storage_gb ?? null,
  storage_type: v.data.storage_type ?? '',
  bandwidth_tb: v.data.bandwidth_tb ?? null,
  virtualization: v.data.virtualization ?? '',
  status: v.data.status ?? '',
  affiliate_link: v.data.affiliate_link ?? '',
  cpu_model: v.data.benchmarks.yabs?.cpu?.model ?? '',
  os: v.data.benchmarks.yabs?.os?.distro ?? '',
  summary: {
    geekbench_single: v.data.summary.geekbench_single ?? null,
    geekbench_multi: v.data.summary.geekbench_multi ?? null,
    max_iops: v.data.summary.max_iops ?? null,
    max_read_mb_s: v.data.summary.max_read_mb_s ?? null,
    max_write_mb_s: v.data.summary.max_write_mb_s ?? null,
    dd_avg_mb_s: v.data.summary.dd_avg_mb_s ?? null,
    best_iperf_send: v.data.summary.best_iperf_send ?? null,
    speedtest_best_download: v.data.summary.speedtest_best_download ?? null,
  },
}));
---

<Layout title="Compare VPS plans" active="compare">
  <!-- Page head -->
  <section class="shell pt-11 pb-7">
    <nav class="flex items-center gap-2 text-[12px]" aria-label="Breadcrumb">
      <a href="/" class="font-medium text-accent hover:underline">Dashboard</a>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-ink-tertiary">
        <path d="M9 18l6-6-6-6" />
      </svg>
      <span class="text-ink-tertiary">Compare</span>
    </nav>

    <div class="mt-4 flex flex-wrap items-end justify-between gap-6">
      <div>
        <h1 class="font-display text-[40px] leading-[1.05] font-bold tracking-tight text-ink">
          Compare plans
        </h1>
        <p class="mt-3 max-w-[620px] text-[14px] leading-[1.55] text-ink-secondary">
          Best result in each measured row is marked. A dash means the benchmark did not produce
          a number &mdash; it is never treated as zero.
        </p>
      </div>
      <a
        href="/"
        class="flex h-10 items-center gap-2 border border-ink px-3.5 text-[13px] font-medium text-ink transition-colors hover:bg-surface-subtle"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12.22 2h-.44a2 2 0 0 0-2 1.72l-.25 1.8a2 2 0 0 1-1.67 1.67l-1.8.25A2 2 0 0 0 4.34 9.4v.44a2 2 0 0 0 1.72 2l1.8.25a2 2 0 0 1 1.67 1.67l.25 1.8a2 2 0 0 0 2 1.72h.44a2 2 0 0 0 2-1.72l.25-1.8a2 2 0 0 1 1.67-1.67l1.8-.25a2 2 0 0 0 1.72-2v-.44a2 2 0 0 0-1.72-2l-1.8-.25a2 2 0 0 1-1.67-1.67l-.25-1.8A2 2 0 0 0 14.22 2z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
        Change selection
      </a>
    </div>
  </section>

  <section class="shell pb-20">
    {/*
      The payload must sit above the script below: `is:inline` runs during
      parsing, so a JSON node placed after it would not exist yet.
    */}
    <script type="application/json" id="all-vps" set:html={JSON.stringify(slim)}></script>
    <div id="compare"></div>
  </section>

  <script is:inline>
    (function () {
      const all = JSON.parse(document.getElementById('all-vps').textContent);
      const ids = new URLSearchParams(location.search).get('ids')?.split(',').filter(Boolean) ?? [];
      // Keep the order the visitor picked them in on the dashboard.
      const plans = ids.map((id) => all.find((v) => v.slug === id)).filter(Boolean);
      const root = document.getElementById('compare');

      const esc = (s) =>
        String(s).replace(/[&<>"']/g, (c) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]
        );

      const MISS = '—';
      const ZERO_DECIMAL = ['IDR', 'JPY', 'KRW', 'VND', 'CLP'];
      const num = (v) => (typeof v === 'number' ? v.toLocaleString('en-US') : MISS);
      const withUnit = (v, unit) => (v === null || v === undefined ? MISS : `${num(v)} ${unit}`);

      /**
       * Mirrors src/lib/format.ts. IDR renders without decimals because two
       * fraction digits read as precision nobody can actually pay.
       */
      function money(d) {
        if (d.price_monthly === null) return MISS;
        const cur = d.currency || 'USD';
        const whole = ZERO_DECIMAL.includes(cur.toUpperCase());
        return new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: cur,
          minimumFractionDigits: whole ? 0 : 2,
          maximumFractionDigits: whole ? 0 : 2,
        }).format(d.price_monthly);
      }

      /**
       * iperf figures arrive as strings in mixed units ("1.07 Gbits/sec",
       * "935 Mbits/sec"). Normalised to Mbit/s so the row can be compared
       * and scaled; the displayed text stays exactly as the tool reported it.
       */
      function toMbps(s) {
        if (!s || s === 'busy') return null;
        const m = String(s).match(/^([\d.]+)\s*([KMG])/i);
        if (!m) return null;
        const mult = { k: 1e-3, m: 1, g: 1e3 }[m[2].toLowerCase()];
        return parseFloat(m[1]) * mult;
      }

      function toNumber(s) {
        const n = parseFloat(String(s ?? '').replace(/[^0-9.]/g, ''));
        return Number.isFinite(n) ? n : null;
      }

      const rows = [
        { section: 'Price and specification' },
        { label: 'Monthly price', text: money, value: (d) => d.price_monthly, lower: true },
        { label: 'vCPU', text: (d) => num(d.cpu_cores), value: (d) => d.cpu_cores },
        { label: 'Memory', text: (d) => withUnit(d.ram_gb, 'GB'), value: (d) => d.ram_gb },
        { label: 'Storage', text: (d) => (d.storage_gb === null ? MISS : `${num(d.storage_gb)} GB ${d.storage_type}`), value: (d) => d.storage_gb },
        { label: 'Monthly bandwidth', text: (d) => withUnit(d.bandwidth_tb, 'TB'), value: (d) => d.bandwidth_tb },
        { label: 'Virtualization', text: (d) => d.virtualization || MISS },
        { label: 'Operating system', text: (d) => d.os || MISS },

        { section: 'CPU' },
        { label: 'Geekbench 6 single', text: (d) => num(d.summary.geekbench_single), value: (d) => d.summary.geekbench_single },
        { label: 'Geekbench 6 multi', text: (d) => num(d.summary.geekbench_multi), value: (d) => d.summary.geekbench_multi },
        { label: 'CPU model', text: (d) => d.cpu_model || MISS },

        { section: 'Disk' },
        { label: 'Max IOPS (fio 4k)', text: (d) => num(d.summary.max_iops), value: (d) => d.summary.max_iops },
        { label: 'Max sequential read', text: (d) => withUnit(d.summary.max_read_mb_s, 'MB/s'), value: (d) => d.summary.max_read_mb_s },
        { label: 'Max sequential write', text: (d) => withUnit(d.summary.max_write_mb_s, 'MB/s'), value: (d) => d.summary.max_write_mb_s },
        { label: 'bench.sh sequential avg', text: (d) => withUnit(d.summary.dd_avg_mb_s, 'MB/s'), value: (d) => d.summary.dd_avg_mb_s },

        { section: 'Network' },
        { label: 'Best iperf3 send', text: (d) => d.summary.best_iperf_send || MISS, value: (d) => toMbps(d.summary.best_iperf_send) },
        { label: 'Best speedtest download', text: (d) => d.summary.speedtest_best_download || MISS, value: (d) => toNumber(d.summary.speedtest_best_download) },
      ];

      if (plans.length < 2) {
        root.innerHTML =
          '<div class="border border-line bg-surface-subtle p-8 text-center">' +
          '<p class="text-[15px] font-semibold text-ink">Pick at least two plans to compare.</p>' +
          '<p class="mt-1.5 text-[13px] text-ink-secondary">Tick two or more rows on the dashboard.</p>' +
          '<a href="/" class="mt-5 inline-flex h-10 items-center bg-accent px-4 text-[13px] font-semibold text-white">Back to dashboard</a>' +
          '</div>';
        return;
      }

      function buyCell(d) {
        const buy = d.affiliate_link
          ? `<a href="${esc(d.affiliate_link)}" target="_blank" rel="noopener noreferrer sponsored" ` +
            `class="flex h-10 w-full items-center justify-center gap-2 bg-accent text-[13px] font-semibold text-white transition-opacity hover:opacity-90">` +
            `Buy VPS <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg></a>`
          : '';
        const details =
          `<a href="/vps/${esc(d.slug)}" class="text-center text-[12px] font-medium text-accent hover:underline">View full benchmarks</a>`;
        return `<div class="mt-4 flex flex-col gap-2">${buy}${details}</div>`;
      }

      let html = '<div class="border-b-2 border-ink">';
      html += '<div class="flex items-start">';
      html += '<div class="w-[288px] shrink-0 px-8 pb-5"><span class="section-label">' + plans.length + ' PLANS</span></div>';
      for (const d of plans) {
        html +=
          '<div class="min-w-0 flex-1 px-5 pb-5">' +
          `<span class="mono block text-[10px] font-semibold tracking-[0.09em] text-accent">${esc(d.provider.toUpperCase())}</span>` +
          `<span class="mt-1.5 block text-[15px] font-semibold text-ink">${esc(d.title)}</span>` +
          `<span class="mono mt-0.5 block text-[11px] text-ink-tertiary">${esc(d.location)}</span>` +
          `<span class="mt-3 flex items-baseline gap-1.5"><span class="mono text-[18px] font-semibold text-ink">${esc(money(d))}</span>` +
          `<span class="text-[11px] text-ink-tertiary">per month</span></span>` +
          `<span class="mono mt-1 block text-[11px] text-ink-secondary">${esc([d.cpu_cores, d.ram_gb ? d.ram_gb + ' GB' : null, d.storage_gb ? d.storage_gb + ' GB' : null].filter(Boolean).join(' · '))}</span>` +
          buyCell(d) +
          '</div>';
      }
      html += '</div></div>';

      for (const row of rows) {
        if (row.section) {
          html +=
            `<div class="flex items-center gap-3.5 ${html.includes('border-t border-line') ? 'mt-8 border-t border-line' : 'mt-3.5'} pt-3.5">` +
            `<span class="section-label">${esc(row.section.toUpperCase())}</span>` +
            '<span class="hairline flex-1"></span></div>';
          continue;
        }

        const values = plans.map((d) => (row.value ? row.value(d) : null));
        const present = values.filter((v) => typeof v === 'number' && isFinite(v));
        const best =
          present.length === 0 ? -1 : values.indexOf(row.lower ? Math.min(...present) : Math.max(...present));
        const scale = present.length ? Math.max(...present) : 0;

        html += '<div class="flex items-center border-b border-line">';
        html += `<div class="w-[288px] shrink-0 px-8"><span class="text-[13px] text-ink-secondary">${esc(row.label)}</span></div>`;

        for (let i = 0; i < plans.length; i++) {
          const isBest = i === best;
          const text = row.text(plans[i]);
          const missing = text === MISS;
          const v = values[i];

          html += '<div class="min-w-0 flex-1 px-5 py-3">';
          html +=
            `<span class="mono text-[13px] ${isBest ? 'font-semibold text-ink' : missing ? 'text-missing' : 'text-ink'}">${esc(text)}</span>` +
            (isBest ? '<span class="best-tag">BEST</span>' : '');
          if (missing) html += '<span class="mt-0.5 block text-[10px] text-ink-tertiary">not run</span>';
          if (typeof v === 'number' && isFinite(v) && scale > 0) {
            const w = Math.max(2, Math.round((v / scale) * 100));
            html += `<span class="mt-1.5 block h-[3px] w-[132px] bg-[#dedede]"><i class="block h-full bg-ink" style="width:${w}%"></i></span>`;
          }
          html += '</div>';
        }
        html += '</div>';
      }

      root.innerHTML = html;
    })();
  </script>
</Layout>