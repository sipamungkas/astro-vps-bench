---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { parseFioOutput, parseIperfOutput } from "../../utils/parsers";
import FioTable from "../../components/FioTable.astro";
import IperfTable from "../../components/IperfTable.astro";
import AffiliateButton from "../../components/AffiliateButton.astro";

export async function getStaticPaths() {
  const vpsEntries = await getCollection("vps");
  return vpsEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"vps">;
}

const { entry } = Astro.props;
const { data } = entry;

const fioResults = parseFioOutput(data.raw_yabs_output);
const iperf4Results = parseIperfOutput(data.raw_yabs_output, "IPv4");
const iperf6Results = parseIperfOutput(data.raw_yabs_output, "IPv6");

function daysAgo(date) {
  const now = new Date();
  const diff = Math.floor((now - date) / (1000 * 60 * 60 * 24));
  return diff === 0 ? 'today' : `${diff} day${diff > 1 ? 's' : ''} ago`;
}
---
<Layout title={data.title}>
  <div class="max-w-5xl mx-auto px-2 md:px-0">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-6 gap-2">
      <div class="flex items-center gap-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-gradient-to-r from-blue-500 to-cyan-400 text-white font-bold text-lg shadow">
          {data.provider}
        </span>
        <div class="flex flex-col">
          <h1 class="text-2xl font-extrabold text-gray-900 leading-tight">{data.title}</h1>
          <span class="text-sm text-gray-400 flex items-center gap-1"><svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 12.414a4 4 0 10-1.414 1.414l4.243 4.243a1 1 0 001.414-1.414z"/></svg>{data.location}</span>
        </div>
      </div>
      <button class="bg-gradient-to-r from-blue-600 to-cyan-500 text-white px-5 py-2 rounded-lg font-semibold flex items-center gap-2 shadow hover:scale-105 hover:brightness-110 transition text-sm mt-4 md:mt-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4"/></svg> Add to Comparison</button>
    </div>
    <!-- Hero Card -->
    <div class="bg-gradient-to-br from-blue-50 to-white border border-blue-100 rounded-2xl shadow-lg p-6 mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-3xl font-extrabold text-blue-700">{new Intl.NumberFormat('en-US', { style: 'currency', currency: data.currency }).format(data.price_monthly)}</span>
          <span class="text-base text-gray-400">/month</span>
          <span class="ml-2 px-2 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-bold">{data.status}</span>
        </div>
        <div class="flex flex-wrap gap-2 mt-2">
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-xs font-semibold"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18V6h12v12H6z"/></svg>{data.cpu_cores} CPU</span>
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-cyan-100 text-cyan-700 text-xs font-semibold"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>{data.ram_gb} GB RAM</span>
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 17V7a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>{data.storage_gb} GB {data.storage_type}</span>
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-cyan-50 text-cyan-700 text-xs font-semibold"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 16l4-4m0 0l-4-4m4 4H7"/></svg>{data.bandwidth_tb} TB BW</span>
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-xs font-semibold"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4"/></svg>{data.virtualization}</span>
        </div>
        <div class="flex items-center gap-2 mt-4">
          <AffiliateButton link={data.affiliate_link} providerName="Purchase VPS" />
        </div>
      </div>
      <div class="flex flex-col gap-2 items-end text-xs text-gray-400">
        <span class="flex items-center gap-1"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8v4l3 3"/></svg>Last updated {daysAgo(data.last_updated)}</span>
        <div class="flex flex-wrap gap-1 mt-2">
          {data.tags.map(tag => (<span class="bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full font-mono tracking-wide">{tag}</span>))}
        </div>
      </div>
    </div>
    <!-- Overview Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      <!-- System Information Card -->
      <div class="bg-white border border-blue-100 rounded-xl p-6 flex flex-col gap-2 shadow-sm hover:shadow-lg transition">
        <h3 class="font-bold text-lg mb-2 text-blue-700 flex items-center gap-2"><svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18V6h12v12H6z"/></svg>System Information</h3>
        <div class="text-sm flex flex-col gap-1">
          <div><span class="font-semibold text-gray-700">Provider:</span> {data.provider}</div>
          <div><span class="font-semibold text-gray-700">Plan:</span> {data.title}</div>
          <div><span class="font-semibold text-gray-700">CPU Cores:</span> {data.cpu_cores}</div>
          <div><span class="font-semibold text-gray-700">RAM:</span> {data.ram_gb}GB</div>
          <div><span class="font-semibold text-gray-700">Storage:</span> {data.storage_gb}GB {data.storage_type}</div>
          <div><span class="font-semibold text-gray-700">Location:</span> {data.location}</div>
          <div><span class="font-semibold text-gray-700">Virtualization:</span> {data.virtualization}</div>
        </div>
      </div>
      <!-- Geekbench Results Card -->
      <div class="bg-white border border-blue-100 rounded-xl p-6 flex flex-col gap-2 shadow-sm hover:shadow-lg transition">
        <h3 class="font-bold text-lg mb-2 text-blue-700 flex items-center gap-2"><svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 16h-1v-4h-1m1-4h.01"/></svg>Geekbench Results</h3>
        <div class="flex gap-4 mb-2">
          <div class="flex flex-col items-center bg-blue-50 rounded-lg px-4 py-2">
            <span class="text-2xl font-bold text-gray-900">—</span>
            <span class="text-xs text-gray-500">Single-Core Score</span>
          </div>
          <div class="flex flex-col items-center bg-blue-50 rounded-lg px-4 py-2">
            <span class="text-2xl font-bold text-gray-900">—</span>
            <span class="text-xs text-gray-500">Multi-Core Score</span>
          </div>
        </div>
        <span class="text-xs text-gray-400">(Run Geekbench on this VPS to see results!)</span>
      </div>
      <!-- Pricing Card -->
      <div class="bg-white border border-blue-100 rounded-xl p-6 flex flex-col gap-2 shadow-sm hover:shadow-lg transition">
        <h3 class="font-bold text-lg mb-2 text-blue-700 flex items-center gap-2"><svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4"/></svg>Pricing</h3>
        <div class="flex flex-col gap-2 mb-2">
          <div class="bg-blue-50 rounded-lg px-4 py-2 flex flex-col items-center">
            <span class="text-2xl font-bold text-blue-700">{new Intl.NumberFormat('en-US', { style: 'currency', currency: data.currency }).format(data.price_monthly)}</span>
            <span class="text-xs text-gray-500">per month</span>
          </div>
        </div>
        <AffiliateButton link={data.affiliate_link} providerName="Purchase VPS" />
      </div>
    </div>
    <!-- Benchmarks Stat Blocks -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
      <!-- Disk I/O Performance -->
      <div class="bg-gradient-to-br from-blue-50 to-white border border-blue-100 rounded-xl p-6 shadow-sm hover:shadow-lg transition">
        <h3 class="font-bold text-lg mb-4 text-blue-700 flex items-center gap-2"><svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 17V7a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>Disk I/O Performance</h3>
        <div class="flex gap-6 mb-2">
          <div class="flex flex-col items-center">
            <span class="text-2xl font-bold text-blue-700">{fioResults.length > 0 ? fioResults[0].read : '—'}</span>
            <span class="text-xs text-gray-500">Read Speed</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="text-2xl font-bold text-blue-700">{fioResults.length > 0 ? fioResults[0].write : '—'}</span>
            <span class="text-xs text-gray-500">Write Speed</span>
          </div>
        </div>
        <div class="mt-2 text-xs text-gray-500 flex items-center gap-1"><span>Best for:</span> <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-blue-100 text-blue-700">🗄️ Storage, 🕸️ Web</span></div>
      </div>
      <!-- Network Performance -->
      <div class="bg-gradient-to-br from-cyan-50 to-white border border-blue-100 rounded-xl p-6 shadow-sm hover:shadow-lg transition">
        <h3 class="font-bold text-lg mb-4 text-blue-700 flex items-center gap-2"><svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 16l4-4m0 0l-4-4m4 4H7"/></svg>Network Performance</h3>
        <div class="flex gap-6 mb-2">
          <div class="flex flex-col items-center">
            <span class="text-2xl font-bold text-cyan-700">{iperf4Results.length > 0 ? iperf4Results[0].sendSpeed : '—'}</span>
            <span class="text-xs text-gray-500">Send Speed</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="text-2xl font-bold text-cyan-700">{iperf4Results.length > 0 ? iperf4Results[0].recvSpeed : '—'}</span>
            <span class="text-xs text-gray-500">Receive Speed</span>
          </div>
        </div>
        <div class="mt-2 text-xs text-gray-500 flex items-center gap-1"><span>Best for:</span> <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-cyan-100 text-cyan-700">🌐 CDN, 🚀 Fast Network</span></div>
      </div>
    </div>
    <!-- Collapsible Benchmark Tables -->
    <div class="mb-6">
      <details class="bg-blue-50 rounded-lg border border-blue-100">
        <summary class="cursor-pointer text-base font-semibold p-3 text-blue-600 hover:bg-blue-100 rounded-t-lg flex items-center gap-2"><svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 17V7a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>Disk Benchmark Details</summary>
        <div class="p-4">
          {fioResults.length > 0 ? (
            <FioTable results={fioResults} />
          ) : (
            <div class="text-gray-400 text-xs">No disk benchmark data available.</div>
          )}
        </div>
      </details>
      <details class="bg-cyan-50 rounded-lg border border-blue-100 mt-2">
        <summary class="cursor-pointer text-base font-semibold p-3 text-blue-600 hover:bg-cyan-100 rounded-t-lg flex items-center gap-2"><svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 16l4-4m0 0l-4-4m4 4H7"/></svg>Network Benchmark Details</summary>
        <div class="p-4">
          {iperf4Results.length > 0 ? (
            <IperfTable results={iperf4Results} ipVersion="IPv4" />
          ) : (
            <div class="text-gray-400 text-xs">No network benchmark data available.</div>
          )}
        </div>
      </details>
    </div>
    <!-- Raw Output Section -->
    <div class="mb-8">
      <details class="bg-gray-100 rounded-lg">
        <summary class="cursor-pointer text-base font-semibold p-3 text-blue-500 hover:bg-gray-100 rounded-t-lg flex items-center gap-2"><svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8v4l3 3"/></svg>Raw YABS Output <button class="ml-2 px-2 py-0.5 rounded bg-blue-100 text-blue-700 text-xs font-semibold hover:bg-blue-200 transition" onclick="navigator.clipboard.writeText(this.parentElement.nextElementSibling.textContent)">Copy</button></summary>
        <pre class="bg-gray-50 p-4 rounded-b-lg overflow-x-auto text-xs text-gray-700"><code>{data.raw_yabs_output}</code></pre>
      </details>
    </div>
    <div class="mb-8">
      <details class="bg-gray-100 rounded-lg">
        <summary class="cursor-pointer text-base font-semibold p-3 text-blue-500 hover:bg-gray-100 rounded-t-lg flex items-center gap-2"><svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8v4l3 3"/></svg>Raw bench.sh Output <button class="ml-2 px-2 py-0.5 rounded bg-blue-100 text-blue-700 text-xs font-semibold hover:bg-blue-200 transition" onclick="navigator.clipboard.writeText(this.parentElement.nextElementSibling.textContent)">Copy</button></summary>
        <pre class="bg-gray-50 p-4 rounded-b-lg overflow-x-auto text-xs text-gray-700"><code>{data.raw_benchsh_output}</code></pre>
      </details>
    </div>
  </div>
</Layout>
