---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import VPSCard from '../components/VPSCard.astro';

const allVps = await getCollection('vps');
---

<Layout title="VPS Benchmarks">
	<section class="mb-12 text-center">
		<h1 class="text-5xl md:text-6xl font-extrabold bg-gradient-to-r from-cyan-400 to-blue-500 text-transparent bg-clip-text mb-4 drop-shadow-lg">VPS Benchmark Leaderboard</h1>
		<p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto mb-2">Discover and compare the best VPS providers, benchmarked for real-world performance. Minimalist, fast, and beautiful.</p>
	</section>
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
		{allVps.map(vps => (
			<VPSCard vps={vps} />
		))}
	</div>
</Layout>
