---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { money, num } from '../lib/format';

const allVps = await getCollection('vps');

/**
 * Filter facets.
 *
 * `tools/vps-bench` splits the provider into a short name and a legal entity,
 * so the facet uses `provider` ("Nevacloud"), never "Nevacloud (PT Deneva)".
 * Countries come from the tail of `location` so the facet does not break when a
 * city name changes.
 */
const providers = [...new Set(allVps.map((v) => v.data.provider).filter(Boolean))].sort((a, b) =>
  a.localeCompare(b)
);

const countries = [
  ...new Set(
    allVps
      .map((v) => (v.data.location ?? '').split(',').pop()?.trim() ?? '')
      .filter(Boolean)
  ),
].sort((a, b) => a.localeCompare(b));

const nmb = num;

/**
 * Row model.
 *
 * Only fields the table and the filters actually read are sent to the browser;
 * the `benchmarks` block stays out of the payload.
 */
const rows = allVps.map((v) => {
  const d = v.data;
  return {
    slug: d.slug,
    provider: d.provider,
    title: d.title,
    location: d.location ?? '',
    country: (d.location ?? '').split(',').pop()?.trim() ?? '',
    price: d.price_monthly ?? null,
    currency: d.currency ?? 'USD',
    cpu: d.cpu_cores ?? null,
    ram: d.ram_gb ?? null,
    storage: d.storage_gb ?? null,
    storageType: d.storage_type ?? '',
    bandwidth: d.bandwidth_tb ?? null,
    virt: d.virtualization ?? '',
    affiliate: d.affiliate_link ?? '',
    gb: d.summary.geekbench_single ?? null,
    iops: d.summary.max_iops ?? null,
    net: d.summary.best_iperf_send ?? null,
  };
});

/**
 * Bar scales are taken across the whole dataset, so a bar always means
 * "relative to the best plan listed", not "relative to its own row".
 */
const maxGb = Math.max(1, ...rows.map((r) => r.gb ?? 0));
const maxIops = Math.max(1, ...rows.map((r) => r.iops ?? 0));

const pct = (v: number | null, max: number) =>
  v === null || v === undefined || max <= 0 ? 0 : Math.max(2, Math.round((v / max) * 100));

// Default order: strongest disk first, which is the number most people shop on.
rows.sort((a, b) => (b.iops ?? -1) - (a.iops ?? -1));
---

<Layout title="VPS benchmark dashboard" active="dashboard">
  <!-- Masthead -->
  <section class="shell pt-14 pb-8">
    <p class="eyebrow">YABS.sh &middot; bench.sh &middot; normalised</p>
    <h1 class="mt-4 font-display text-[44px] leading-[1.05] font-bold tracking-tight text-ink">
      VPS benchmark dashboard
    </h1>
    <p class="mt-4 max-w-[660px] text-[16px] leading-[1.6] text-ink-secondary">
      Every plan here was benchmarked on the same footing. Disk, CPU and network figures are
      normalised to comparable units, so a 4&nbsp;vCPU plan can sit next to a 1&nbsp;vCPU plan without
      guessing.
    </p>
  </section>

  <!-- Filters -->
  <section class="border-y border-line bg-surface">
    <div class="shell flex flex-wrap items-center gap-3 py-3.5">
      <div class="flex h-10 min-w-[260px] flex-1 items-center gap-2.5 border border-ink px-3.5">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-ink-tertiary">
          <circle cx="11" cy="11" r="8"></circle><path d="M21 21l-4.35-4.35"></path>
        </svg>
        <input
          id="q"
          type="search"
          placeholder="Search provider, plan or location"
          aria-label="Search plans"
          class="w-full bg-transparent text-[13px] text-ink outline-none placeholder:text-ink-tertiary"
        />
      </div>

      <div class="relative">
        <label class="sr-only" for="f-provider">Filter by provider</label>
        <select
          id="f-provider"
          class="h-10 appearance-none border border-ink bg-surface py-0 pr-9 pl-3 text-[13px] text-ink outline-none"
        >
          <option value="">All providers</option>
          {providers.map((p) => <option value={p}>{p}</option>)}
        </select>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-ink-tertiary">
          <path d="M6 9l6 6 6-6" />
        </svg>
      </div>

      <div class="relative">
        <label class="sr-only" for="f-country">Filter by country</label>
        <select
          id="f-country"
          class="h-10 appearance-none border border-ink bg-surface py-0 pr-9 pl-3 text-[13px] text-ink outline-none"
        >
          <option value="">All countries</option>
          {countries.map((c) => <option value={c}>{c}</option>)}
        </select>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-ink-tertiary">
          <path d="M6 9l6 6 6-6" />
        </svg>
      </div>

      <button
        id="clear"
        type="button"
        class="hidden h-10 border border-line px-3 text-[13px] font-medium text-ink-tertiary transition-colors hover:text-ink"
      >
        Clear
      </button>
    </div>
  </section>

  <!-- Result count + sort -->
  <section class="shell flex items-center justify-between pt-5 pb-4">
    <p class="flex items-center gap-2 text-[13px] text-ink-secondary">
      <span id="count" class="mono text-[13px] font-semibold text-ink">{rows.length}</span>
      <span>
        plans &middot; <span id="count-providers">{providers.length}</span> providers &middot;
        <span id="count-countries">{countries.length}</span> countries
      </span>
    </p>
    <p class="flex items-center gap-2 text-[12px] text-ink-tertiary">
      Sorted by max IOPS, high to low
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 9l6 6 6-6" />
      </svg>
    </p>
  </section>

  <!-- Plans -->
  <section class="shell">
    <div class="overflow-x-auto">
      <table class="dtable dtable--roomy min-w-[1080px]">
        <thead>
          <tr class="border-b border-ink">
            <th class="w-11"><span class="sr-only">Select</span></th>
            <th>Plan</th>
            <th class="text-right">Price</th>
            <th>Specification</th>
            <th class="text-right">CPU score</th>
            <th class="text-right">Max IOPS</th>
            <th class="text-right">Network</th>
            <th class="text-right"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody id="rows">
          {
            rows.map((r) => (
              <tr
                data-slug={r.slug}
                data-title={r.title}
                data-provider={r.provider}
                data-country={r.country}
                data-search={`${r.provider} ${r.title} ${r.location} ${r.storageType} ${r.virt}`.toLowerCase()}
              >
                <td>
                  <label class="flex cursor-pointer items-center">
                    <span class="sr-only">Select {r.title}</span>
                    <input
                      type="checkbox"
                      class="peer sr-only"
                      data-slug={r.slug}
                    />
                    <span class="flex h-[18px] w-[18px] items-center justify-center border border-ink bg-surface peer-checked:bg-ink peer-checked:border-ink">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 peer-checked:opacity-100">
                        <path d="M20 6L9 17l-5-5" />
                      </svg>
                    </span>
                  </label>
                </td>

                <td class="!whitespace-normal">
                  <span class="mono block text-[10px] font-semibold tracking-[0.09em] text-accent">
                    {r.provider.toUpperCase()}
                  </span>
                  <span class="mt-1 block text-[15px] font-semibold text-ink">{r.title}</span>
                  <span class="mono mt-0.5 block text-[11px] text-ink-tertiary">{r.location}</span>
                </td>

                <td class="text-right">
                  <span class="mono block text-[15px] font-semibold text-ink">
                    {money(r.price, r.currency)}
                  </span>
                  <span class="block text-[11px] text-ink-tertiary">per month</span>
                </td>

                <td class="!whitespace-normal">
                  <span class="mono block text-[11px] leading-[1.55] text-ink-secondary">
                    {r.cpu ?? '—'} vCPU &middot; {r.ram ?? '—'} GB RAM
                    <br />
                    {r.storage ?? '—'} GB {r.storageType}
                    <br />
                    {r.bandwidth ?? '—'} TB &middot; {r.virt || '—'}
                  </span>
                </td>

                <td class="text-right">
                  {r.gb === null ? (
                    <>
                      <span class="mono block text-[14px] font-semibold text-missing">&mdash;</span>
                      <span class="block text-[10px] text-ink-tertiary">not run</span>
                    </>
                  ) : (
                    <>
                      <span class="mono block text-[14px] font-semibold text-ink">
                        {nmb(r.gb)}
                      </span>
                      <span class="mt-1.5 mb-1 ml-auto block h-[3px] w-[112px] bg-[#dedede]">
                        <i
                          class="block h-full bg-ink"
                          style={`width:${pct(r.gb, maxGb)}%`}
                        ></i>
                      </span>
                      <span class="block text-[10px] text-ink-tertiary">Geekbench 6</span>
                    </>
                  )}
                </td>

                <td class="text-right">
                  <span class="mono block text-[14px] font-semibold text-ink">
                    {nmb(r.iops)}
                  </span>
                  <span class="mt-1.5 mb-1 ml-auto block h-[3px] w-[112px] bg-[#dedede]">
                    <i
                      class="block h-full bg-ink"
                      style={`width:${pct(r.iops, maxIops)}%`}
                    ></i>
                  </span>
                  <span class="block text-[10px] text-ink-tertiary">fio 4k mixed</span>
                </td>

                <td class="text-right">
                  <span class="mono block text-[13px] text-ink">{r.net ?? '—'}</span>
                  <span class="block text-[10px] text-ink-tertiary">best iperf send</span>
                </td>

                <td>
                  <div class="flex flex-col items-end gap-2">
                    {r.affiliate && (
                      <a
                        href={r.affiliate}
                        target="_blank"
                        rel="noopener noreferrer sponsored"
                        class="flex h-[34px] items-center gap-1.5 bg-accent px-3 text-[12px] font-semibold text-white transition-opacity hover:opacity-90"
                      >
                        Buy VPS
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M7 17L17 7M9 7h8v8" />
                        </svg>
                      </a>
                    )}
                    <a
                      href={`/vps/${r.slug}`}
                      class="text-[12px] font-medium text-accent hover:underline"
                    >
                      Details &rarr;
                    </a>
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p id="empty" class="hidden py-10 text-center text-[13px] text-ink-tertiary">
      No plan matches the current filter.
    </p>

    <!-- Referral disclosure: stated plainly next to the links it describes. -->
    <p class="flex items-center gap-2.5 py-4 text-[12px] text-ink-tertiary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0">
        <circle cx="12" cy="12" r="10" /><path d="M12 16v-4M12 8h.01" />
      </svg>
      Buy links go to our referral partners. Using them costs you nothing extra and keeps this
      benchmark database running.
    </p>
  </section>

  <!-- Selection bar: only present once something is selected. -->
  <section
    id="selection"
    class="hidden bg-surface-inverse text-white"
    aria-live="polite"
  >
    <div class="shell flex flex-wrap items-center justify-between gap-4 py-5">
      <div>
        <p class="mono text-[12px] font-semibold tracking-wide">
          <span id="sel-count">0</span> selected
        </p>
        <p id="sel-names" class="mt-1 text-[12px] text-white/55"></p>
      </div>
      <div class="flex items-center gap-4">
        <button id="sel-clear" type="button" class="text-[13px] font-medium text-white/55 hover:text-white">
          Clear
        </button>
        <a
          id="compare-link"
          href="/compare"
          class="flex h-[42px] items-center gap-2.5 bg-accent px-[18px] text-[13px] font-semibold text-white"
        >
          <span id="compare-label">Compare plans</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const q = document.getElementById('q');
      const fProvider = document.getElementById('f-provider');
      const fCountry = document.getElementById('f-country');
      const clearBtn = document.getElementById('clear');
      const tbody = document.getElementById('rows');
      const empty = document.getElementById('empty');
      const count = document.getElementById('count');
      const countProviders = document.getElementById('count-providers');
      const countCountries = document.getElementById('count-countries');
      const selection = document.getElementById('selection');
      const selCount = document.getElementById('sel-count');
      const selNames = document.getElementById('sel-names');
      const compareLink = document.getElementById('compare-link');
      const compareLabel = document.getElementById('compare-label');
      const selClear = document.getElementById('sel-clear');

      const trs = Array.from(tbody.querySelectorAll('tr'));
      const boxes = Array.from(tbody.querySelectorAll('input[type=checkbox]'));

      const visibleRows = () => trs.filter((tr) => tr.style.display !== 'none');

      function applyFilters() {
        const term = q.value.trim().toLowerCase();
        const prov = fProvider.value;
        const ctry = fCountry.value;
        const providers = new Set();
        const countries = new Set();

        for (const tr of trs) {
          const ok =
            (!term || tr.dataset.search.includes(term)) &&
            (!prov || tr.dataset.provider === prov) &&
            (!ctry || tr.dataset.country === ctry);
          tr.style.display = ok ? '' : 'none';
          if (ok) {
            providers.add(tr.dataset.provider);
            countries.add(tr.dataset.country);
          }
        }

        const visible = visibleRows();
        empty.classList.toggle('hidden', visible.length !== 0);
        count.textContent = visible.length;
        countProviders.textContent = providers.size;
        countCountries.textContent = countries.size;
        clearBtn.classList.toggle('hidden', !term && !prov && !ctry);
        updateSelection();
      }

      function selectedBoxes() {
        return boxes.filter((b) => b.checked);
      }

      function updateSelection() {
        const visible = new Set(visibleRows());
        const selected = selectedBoxes().filter((b) => visible.has(b.closest('tr')));

        selection.classList.toggle('hidden', selected.length === 0);
        selCount.textContent = selected.length;
        selNames.textContent = selected
          .map((b) => b.closest('tr').dataset.title)
          .join('  ·  ');

        const ids = selectedBoxes().map((b) => b.dataset.slug);
        const count = ids.length;
        compareLabel.textContent = count >= 2 ? 'Compare ' + count + ' plans' : 'Compare plans';
        // One plan is not a comparison, so send it to the detail page instead.
        compareLink.href = count >= 2 ? '/compare?ids=' + ids.join(',') : '/vps/' + (ids[0] || '');
      }

      for (const el of [q, fProvider, fCountry]) {
        el.addEventListener('input', applyFilters);
        el.addEventListener('change', applyFilters);
      }

      for (const b of boxes) b.addEventListener('change', updateSelection);

      clearBtn.addEventListener('click', () => {
        q.value = '';
        fProvider.value = '';
        fCountry.value = '';
        applyFilters();
      });

      selClear.addEventListener('click', () => {
        for (const b of boxes) b.checked = false;
        updateSelection();
      });

      applyFilters();
      updateSelection();
    })();
  </script>
</Layout>